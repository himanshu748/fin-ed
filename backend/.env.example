# =============================================================================
# Backend environment variables: copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf (TTS: Text-to-Speech)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT: Speech-to-Text)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM: use one of the following depending on which provider you use
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here
# Optional exact allowlist: gemini-3.6-flash, gemini-3.5-flash-lite, gemini-2.5-flash
# Delete this line to use the quota-efficient gemini-3.5-flash-lite default.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional persistent Day 4 caller-memory database. The default is
# backend/data/memory/fined.sqlite3 and is ignored by Git.
# FINED_MEMORY_DB_PATH=/absolute/path/to/fined.sqlite3

# Optional persistent Day 7 human-help queue. The default is
# backend/data/escalations/fined.sqlite3 and is ignored by Git.
# FINED_ESCALATION_DB_PATH=/absolute/path/to/fined.sqlite3

# Optional Day 8 call analytics paths. The defaults are private SQLite plus a
# caller-safe JSON snapshot inside backend/data/analytics. Both are ignored.
# FINED_ANALYTICS_DB_PATH=/absolute/path/to/fined.sqlite3
# FINED_ANALYTICS_SNAPSHOT_PATH=/absolute/path/to/public-summary.json

# -----------------------------------------------------------------------------
# Optional Day 6 server-only consented outbound paper-practice reminder
# Create a stored outbound SIP trunk in LiveKit Cloud with the Twilio carrier,
# then put its ST_... ID here. The command also uses existing LiveKit settings.
# Never put recipient numbers or Twilio credentials in this file.
# -----------------------------------------------------------------------------
SIP_OUTBOUND_TRUNK_ID=ST_your_livekit_outbound_trunk_id
# Optional named LiveKit worker. Defaults to my-agent.
# FINED_OUTBOUND_AGENT_NAME=my-agent
# Optional Day 7 demo-only destination for an explicitly requested automated
# acknowledgement callback. Keep this server-only and use E.164 format.
# FINED_ESCALATION_CALLBACK_NUMBER=+91XXXXXXXXXX

# -----------------------------------------------------------------------------
# Optional Angel One SmartAPI read-only market quotes
# Create a SmartAPI app and supply a current access token. If any value is
# missing or invalid, quote tools fail closed while the voice tutor still runs.
# Never expose these values through frontend or NEXT_PUBLIC variables.
# -----------------------------------------------------------------------------
# ANGEL_ONE_API_KEY=
# ANGEL_ONE_ACCESS_TOKEN=
# ANGEL_ONE_CLIENT_LOCAL_IP=
# ANGEL_ONE_CLIENT_PUBLIC_IP=
# ANGEL_ONE_MAC_ADDRESS=
