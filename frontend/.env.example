# =============================================================================
# Frontend environment variables: copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (real-time transport: must match your backend agent's LiveKit project)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Agent dispatch
# Must match the name registered by @server.rtc_session in backend/src/agent.py.
# See https://docs.livekit.io/agents/server/agent-dispatch
# -----------------------------------------------------------------------------
AGENT_NAME=my-agent

# The bundled token endpoint normally works only during direct local development;
# `pnpm dev` binds to 127.0.0.1 and the route accepts only Next's coherent
# loopback forwarding values while rejecting production and untrusted proxies.
# This exact opt-in bypasses those checks for a short-lived public demo only. It
# is unsafe for production; production requires authentication, authorization,
# and rate limiting.
# UNSAFE_ALLOW_UNAUTHENTICATED_PUBLIC_TOKEN_ENDPOINT=true

# -----------------------------------------------------------------------------
# Optional: LiveKit Cloud Sandbox / custom app config
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_CONFIG_ENDPOINT=
# SANDBOX_ID=
